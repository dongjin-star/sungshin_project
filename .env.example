# 토스증권 Open API 자격증명 (PRD §11.1)
#
# 🔴 이 값들은 서버 환경변수로만 존재한다.
#    - NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다
#    - src/lib/toss/client.ts 단 한 파일에서만 읽는다
#    - 실제 값은 .env.local 에 넣는다 (.gitignore 처리됨)
#
# 발급: 토스증권 WTS > 설정 > Open API
# ⚠️ 발급 후 반드시 같은 화면의 "IP 관리"에 이 서버의 아웃바운드 IP를 등록해야 한다.
#    미등록 시 모든 호출이 403 (edge-blocked) 으로 차단된다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 토스 API 베이스 URL (변경할 일 없음)
TOSS_API_BASE=https://openapi.tossinvest.com

# Vercel 처럼 아웃바운드 IP가 고정되지 않는 환경에 배포할 때만 채운다.
# 고정 IP를 가진 실행 환경(Fly.io 등)에 직접 배포한다면 비워둔다 —
# 채워져 있으면 토스로 나가는 모든 요청이 이 프록시를 거친다.
# 만드는 법: infra/toss-proxy/README.md
# 형태: http://<proxy-user>:<proxy-pass>@<host>:<port>
TOSS_PROXY_URL=

# SQLite 캐시 DB 경로
DATABASE_PATH=./data/posture.db

# 배치(cron) 엔드포인트 보호용 토큰. 아무 랜덤 문자열
CRON_SECRET=

# Gemini API 키 — "쉬운 설명" 탭의 AI 부연 설명 (D-04)
#
# 🔴 이 값도 토스 자격증명과 같은 규칙을 따른다.
#    - NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다
#    - src/lib/ai/plain-explanation.ts 단 한 파일에서만 읽는다
#    - 실제 값은 .env.local 에 넣는다 (.gitignore 처리됨)
#
# 발급: https://aistudio.google.com/apikey (무료 등급 있음)
# 비워두면 "AI 설명 더 보기" 버튼을 눌렀을 때 에러만 나고, 나머지 화면은
# 그대로 정상 동작한다 — 규칙 기반 설명(§5.5)은 이 키와 무관하다.
GEMINI_API_KEY=

# 사용할 모델. 비워두면 gemini-3.6-flash(2026-08-28 기준 확인됨). Gemini는
# 모델을 자주 은퇴시킨다 — 404 에러가 나면 응답 메시지에 대체 모델명이
# 나오니 그걸 여기 넣으면 된다. 코드를 고칠 필요는 없다.
GEMINI_MODEL=

# Supabase (2026-08-28 연결, 아직 이 프로젝트에서 실제로 쓰는 코드는 없다 —
# 자리만 잡아둔 상태).
#
# publishable 키는 예전 "anon key"와 같은 성격이라 브라우저 번들에 그대로
# 노출돼도 되는 값이다(그래서 NEXT_PUBLIC_ 접두사) — 토스/Gemini 자격증명과
# 달리 서버 전용 규칙이 적용되지 않는다.
# 발급: Supabase 대시보드 > 프로젝트 > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
