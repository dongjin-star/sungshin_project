# 토스증권 Open API 자격증명 (PRD §11.1)
#
# 🔴 이 값들은 서버 환경변수로만 존재한다.
#    - NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다
#    - src/lib/toss/client.ts 단 한 파일에서만 읽는다
#    - 실제 값은 .env.local 에 넣는다 (.gitignore 처리됨)
#
# 발급: 토스증권 WTS > 설정 > Open API
# ⚠️ 발급 후 반드시 같은 화면의 "IP 관리"에 이 서버의 아웃바운드 IP를 등록해야 한다.
#    미등록 시 모든 호출이 403 (edge-blocked) 으로 차단된다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 토스 API 베이스 URL (변경할 일 없음)
TOSS_API_BASE=https://openapi.tossinvest.com

# SQLite 캐시 DB 경로
DATABASE_PATH=./data/posture.db

# 배치(cron) 엔드포인트 보호용 토큰. 아무 랜덤 문자열
CRON_SECRET=
